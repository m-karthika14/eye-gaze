# Copy this file to config/.env and fill in your real key. config/.env is git-ignored.
# Get a key at https://console.groq.com

GROQ_API_KEY=

# Confirm current production model IDs/pricing at console.groq.com/docs/models before relying on these.
GROQ_WORD_SUGGESTION_MODEL=openai/gpt-oss-20b
GROQ_PHRASE_EXPANSION_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopy-labs/orpheus-3b-0.1-ft
GROQ_STT_MODEL=whisper-large-v3-turbo
